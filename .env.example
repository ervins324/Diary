# ────────────────────────────────────────────────────
# School Diary — Environment Configuration
# Copy this file to .env and adjust values as needed
# ────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────
POSTGRES_USER=diary
POSTGRES_PASSWORD=diary_secret
POSTGRES_DB=diary

# ── Database URLs ──────────────────────────────────
# Async URL used by FastAPI/SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://diary:diary_secret@db:5432/diary
# Sync URL used by Alembic migrations (psycopg2 driver)
ALEMBIC_DATABASE_URL=postgresql://diary:diary_secret@db:5432/diary

# ── Application Settings ──────────────────────────
# ISO date marking the start of the semester (numerator week 1)
SEMESTER_ANCHOR_DATE=2026-09-01

# Gemini API key for AI-powered schedule image parsing
# Leave empty to disable the AI import feature
GEMINI_API_KEY=

# CORS allowed origins (JSON array format)
CORS_ORIGINS=["*"]

# ── Deployment ─────────────────────────────────────
# Host port for the web frontend
WEB_PORT=8080
